@page "/accounts"
@inherits FinancePage
@inject CatalogService Catalog
<PageTitle>Счета · finflow</PageTitle>
<div class="page-heading"><div><div class="eyebrow">ДЕНЬГИ ПОД РУКОЙ</div><h1>Мои счета<span>.</span></h1><p>Карта, наличные и накопления. Все остатки рядом.</p></div><button class="button primary" @onclick="New"><Icon Name="plus" /> Новый счёт</button></div>
@if (Error != null) { <div class="notice error">@Error</div> }
@if (editing)
{
    <section class="panel editor"><h2>@(editId.HasValue ? "Изменить счёт" : "Новый счёт")</h2>
        <form @onsubmit="Save" @onsubmit:preventDefault><div class="form-grid">
            <label>Название<input required maxlength="80" @bind="name" placeholder="Например, основная карта" @bind:event="oninput" /></label>
            <label>Начальный остаток, ₽<input type="number" step="0.01" @bind="initial" @bind:event="oninput" /></label>
        </div><div class="form-actions"><button class="button primary" disabled="@Busy">Сохранить</button><button type="button" class="button" @onclick="() => editing = false">Отмена</button></div></form>
    </section>
}
@if (accounts.Count == 0) { <div class="panel empty"><Icon Name="wallet" /><h2>Начните с первого счёта</h2><p>Укажите текущий остаток, а затем добавляйте операции.</p><button class="button primary" @onclick="New">Создать счёт</button></div> }
<div class="account-grid">
    @foreach (var a in accounts)
    {
        <article class="panel account-card @(a.IsArchived ? "archived" : "")"><div class="section-title"><span class="account-chip"><Icon Name="wallet" /></span><span class="pill">@(a.IsArchived ? "В архиве" : "RUB")</span></div><h2>@a.Name</h2><strong class="account-balance">@a.Balance.ToString("N2") ₽</strong><p class="muted">Начальный остаток: @a.InitialBalance.ToString("N2") ₽</p>
            <div class="form-actions"><button class="text-button" @onclick="() => Edit(a)">Изменить</button><button class="text-button" disabled="@Busy" @onclick="() => Execute(() => Catalog.ArchiveAccount(a.Id, !a.IsArchived))">@(a.IsArchived ? "Восстановить" : "В архив")</button></div></article>
    }
</div>
@code {
    private List<AccountView> accounts = [];
    private bool editing; private Guid? editId; private string name = ""; private decimal initial;
    protected override async Task Refresh() => accounts = await Catalog.Accounts();
    private void New() { editId = null; name = ""; initial = 0; editing = true; }
    private void Edit(AccountView a) { editId = a.Id; name = a.Name; initial = a.InitialBalance; editing = true; }
    private async Task Save() { if (await Execute(() => Catalog.SaveAccount(editId, name, initial))) editing = false; }
}



