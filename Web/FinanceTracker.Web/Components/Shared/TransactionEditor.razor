@inject TransactionService Transactions
@inject CatalogService Catalog
<section class="panel editor">
    <div class="section-title"><h2>@(Id.HasValue ? "Изменить операцию" : "Новая операция")</h2><button class="text-button" @onclick="Close">Закрыть ×</button></div>
    @if (error != null) { <div class="notice error">@error</div> }
    @if (model != null)
    {
        <form @onsubmit="Save" @onsubmit:preventDefault>
            <div class="form-grid">
                <label>Тип<select @bind="model.Type" @bind:after="() => model.CategoryId = null"><option value="@TransactionType.Expense">Расход</option><option value="@TransactionType.Income">Доход</option></select></label>
                <label>Сумма, ₽<input type="number" step="0.01" min="0.01" max="999999999" required @bind="model.Amount" @bind:event="oninput" /></label>
                <label>Дата<input type="date" required @bind="model.Date" @bind:event="oninput" /></label>
                <label>Счёт<select required @bind="model.AccountId"><option value="@Guid.Empty">Выберите счёт</option>@foreach (var a in accounts.Where(a => !a.IsArchived || a.Id == model.AccountId)) { <option value="@a.Id">@a.Name</option> }</select></label>
                <label>Категория<select @bind="model.CategoryId"><option value="">Без категории</option>@foreach (var c in categories.Where(c => c.Type == model.Type && (!c.IsArchived || c.Id == model.CategoryId))) { <option value="@c.Id">@c.Name</option> }</select></label>
                <label>Комментарий<input maxlength="500" @bind="model.Description" @bind:event="oninput" placeholder="На что потратили или откуда получили" /></label>
            </div><div class="form-actions"><button class="button primary" disabled="@saving">@(saving ? "Сохраняем…" : "Сохранить операцию")</button><button class="button" type="button" @onclick="Close">Отмена</button></div>
        </form>
    }
</section>
@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    private Transaction? model; private List<AccountView> accounts = []; private List<Category> categories = [];
    private bool saving; private string? error;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            accounts = await Catalog.Accounts(); categories = await Catalog.Categories();
            model = Id.HasValue ? await Transactions.Get(Id.Value) : new Transaction { Date = DateOnly.FromDateTime(DateTime.Today), AccountId = accounts.FirstOrDefault(a => !a.IsArchived)?.Id ?? Guid.Empty };
        }
        catch { error = "Не удалось загрузить операцию."; }
    }
    private async Task Save()
    {
        if (saving || model == null) return;
        saving = true; error = null;
        try { await Transactions.Save(model); await Close.InvokeAsync(); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        catch { error = "Не удалось сохранить операцию."; }
        finally { saving = false; }
    }
}



